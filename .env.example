# ===========================================
# VietImmerse Environment Variables
# Copy this file to .env and fill values
# ===========================================

# Database
POSTGRES_DB=VietImmerse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_CONNECTION_STRING=Host=db;Port=5432;Database=VietImmerse_db;Username=postgres;Password=

# JWT Authentication
JWT_SECRET=
JWT_ISSUER=VietImmerse
JWT_AUDIENCE=VietImmerseApp
JWT_EXPIRY_HOURS=24

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NODE_ENV=production

# SMTP Email (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VietImmerse <your-email@gmail.com>

# Cloudinary (Avatar Upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
